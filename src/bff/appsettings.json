{
	"EnvName": "local",

	"AppConfig": {
		"AppName": "Dyvenix BFF",
		"UIRootUrl": "https://localhost:4200"
	},

	"AuthConfig": {
		"Enabled": "true",
		"AllowedOrigins": "*",
		"IdP": {
			"Instance": "https://dyvenix.ciamlogin.com/",
			"Domain": "dyvenix.onmicrosoft.com",
			"TenantId": "1c3cdcca-ba60-4ad2-9892-626f5d92bc09",
			"ClientId": "af02ac5b-78db-42cb-b39d-081d1a793d32",
			"ClientSecret": "",
			"CallbackPath": "/signin-oidc",
			"SignedOutCallbackPath": "/signout-callback-oidc",
			"AppIdUri": "https://dyvenix.com/svr"
		},
		"Scopes": [
			"https://dyvenix.com/svr/access"
			//"https://dyvenix.com/auth/access",
			//"https://dyvenix.com/svr/access"
		]
	},

	"LogConfig": {
		"ApplicationName": "DyvBFF",
		"EnableConsoleLogging": "true",
		"ConsoleLogLevel": "Debug",

		"EnableFileLogging": "true",
		"FileLogLevel": "Debug",
		"FilePath": "D:/Logs/log.txt",

		"EnableDbLogging": "true",
		"DbLogLevel": "Debug",
		"Schema": "Logs",
		"TableName": "LogEvents",
		"DbConnectionString": "Password=pwd;User ID=dyvenix_app;Initial Catalog=dyvenix;Data Source=localhost;Encrypt=False;",
		"BatchPostingLimit": "1",

		"SelfLogPath": "D:/Logs/SerilogSelfLog.txt"
	},

	"ReverseProxy": {
		"Routes": {
			"toSvr": {
				"ClusterId": "svr",
				"Match": {
					"Path": "/svr/{**catch-all}"
				},
				"Metadata": {
					"RequiredScopes": "app.access"
				},
				"Transforms": [
					{ "PathRemovePrefix": "/svr" },
					{ "PathPrefix": "/api" }
				]
			}
		},
		"Clusters": {
			"svr": {
				"Destinations": {
					"svrdest": { "Address": "https://localhost:7001/" }
				}
			}
		}
	},

	"ApiClients": {
		"auth": {
			"BaseUrl": "https://localhost:7001/auth",
			"TimeoutSecs": 30
		},
		"svr": {
			"BaseUrl": "https://localhost:7001/svr",
			"TimeoutSecs": 30
		}
	}
}
